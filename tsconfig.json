{
  "compilerOptions": {
    "target": "ES5",
    "module": "commonjs",
    "removeComments": false,
    "preserveConstEnums": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": false,
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "baseUrl": ".",
    "rootDir": ".",
    "jsx": "preserve",
    "allowJs": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@stores/*": [
        "src/stores/*"
      ]
    }
  },
  "lib": [
    "ES5",
    "ES6",
    "DOM"
  ],
  "downlevelIteration": true,
  "include": [
    "./src",
    "./types",
    "components.d.ts"
  ],
  "compileOnSave": false
}